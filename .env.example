# Copy to .env.local and adjust. Never commit .env.local.

# Production URL of this site (no trailing slash). Used for canonical URLs, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of my-portfolio-backend including /api/v1. Public, not a secret (inlined into the browser bundle).
# Leave empty to render the static /data content without a backend (design work only; the dashboard needs the API).
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Optional, server-only: a different URL for server-side reads (e.g. an internal network address).
# API_URL=http://backend:5000/api/v1

# Optional, server-only: proxy /api/v1 and /uploads through this site so auth cookies stay first-party.
# Use when the API is on a different domain (see the backend README → Deployment), together with:
#   NEXT_PUBLIC_API_URL=/api/v1   and   API_URL=https://api.example.com/api/v1
# API_PROXY_TARGET=https://api.example.com

# Server-only shared secret the backend sends to /api/revalidate after admin changes.
# Must equal REVALIDATE_SECRET in my-portfolio-backend/.env (at least 32 characters).
REVALIDATE_SECRET=
